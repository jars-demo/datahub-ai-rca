# Copy to .env and fill in. Every value can also be entered on the Connections page instead;
# values saved in the UI take precedence over this file. Never commit .env.

# --- Pinecone (free Starter plan is enough) ------------------------------------------------
PINECONE_API_KEY=
# PINECONE_INDEX=acme-support-kb

# --- Langfuse (a fresh Langfuse Cloud project) ---------------------------------------------
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- DataHub -------------------------------------------------------------------------------
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_UI_URL=http://localhost:9002
# Leave empty and run `make datahub-token` (uses the default datahub / datahub login).
DATAHUB_TOKEN=

# --- LLM provider: any of them -------------------------------------------------------------
# anthropic | openai | google | groq | openrouter | mistral | together | deepseek | ollama | custom
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Blank = provider default (Anthropic: claude-opus-5-5). Required for other providers.
LLM_MODEL=
# Only for custom endpoints or self-hosted gateways.
LLM_BASE_URL=
